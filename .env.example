# ==============================================================================
# MiSender / Instantly-App — Environment Configuration Template
# Copy to `.env.local` for local development or configure in Vercel/production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Multi-Tenant Persistence & Schema Isolation)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Mandatory in production once anon schema access is revoked by 20261123_production_hardening_and_automations.sql
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Target schema: 'misender' (production) or 'misender_staging' (staging)
SUPABASE_SCHEMA=misender

# ------------------------------------------------------------------------------
# 2. Mandatory Security & App Core
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ char secret for AES-256-GCM encryption of SMTP/IMAP credentials
ENCRYPTION_KEY=replace-with-32-byte-random-hex-secret
# Dedicated HMAC-SHA256 secret for HttpOnly misender_session cookies (falls back to ENCRYPTION_KEY)
SESSION_SECRET=replace-with-32-byte-random-session-secret
# Dedicated HMAC-SHA256 secret for click tracking open-redirect protection
TRACKING_SECRET=replace-with-32-byte-random-tracking-secret
# Bearer / x-cron-secret token protecting /api/cron/* endpoints
CRON_SECRET=replace-with-random-cron-secret
# Optional API key for programmatic REST API v1 & server-to-server callers
MISENDER_API_KEY=
APP_API_KEY=
# Set to 'true' in production to require valid misender_session cookie or MISENDER_API_KEY on /api/*
ENFORCE_SESSION_AUTH=false
# Optional override for initial founder super_admin seed access code
FOUNDER_ACCESS_CODE=

# ------------------------------------------------------------------------------
# 3. Pending Billing API Keys (Stripe, MercadoPago, Lemon Squeezy)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
MP_USD_TO_ARS_RATE=1200

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_AGENCY=
LEMONSQUEEZY_VARIANT_ID=

# ------------------------------------------------------------------------------
# 4. OAuth (Google Workspace & Microsoft 365 Mailboxes)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/accounts/oauth

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/accounts/oauth

# ------------------------------------------------------------------------------
# 5. AI SDK (Copilot, Icebreakers & Unibox Reply Suggestions)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Upstash Redis (Distributed Rate Limiting)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 7. Enrichment / Email Verification BYOK & SMTP Probe
# ------------------------------------------------------------------------------
EMAIL_VERIFIER_API_KEY=
ENABLE_SMTP_PROBE=false
APOLLO_API_KEY=
HUNTER_API_KEY=
